# Copy this file to `.env` and fill in your own values.
# The notebooks load it with python-dotenv; the library reads each value with
# os.getenv(). NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Project root holding both repositories, so that configs.py resolves
#   <root>/github/psychai/src
#   <root>/github/psychai_publications/publications/llm_moral_emotion
path_project_root=/absolute/path/to/project

# Working directories (configs.py reads each of these; leave blank to skip)
path_results=/absolute/path/to/results
path_resources=/absolute/path/to/resources
path_data_cache=
path_huggingface_cache=
path_datasets_cache=
path_gguf_cache=
path_openml_cache=
path_others_cache=
path_resources_external=

# Raw recordings, used only by the feature-extraction notebooks
path_data_experiment=../resources/raw_data

# External binaries (defaults assume both are on PATH)
path_ffmpeg_bin=ffmpeg
path_ffprobe_bin=ffprobe

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# Required for the main MLLM experiments (experiments_1_9.ipynb):
api_key_gemini=your_gemini_api_key_here

# Only needed for the Vertex AI fine-tuning experiment:
# api_key_gemini_vertex_project_id=your_gcp_project_id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service_account.json

# Only needed for the cross-model comparison (experiment_17_18.ipynb). Each
# model is skipped with a message when its key is absent, so you can set only
# the providers you have.
# api_key_claude=            # Anthropic (ANTHROPIC_API_KEY also accepted)
# api_key_openai=            # OpenAI
# api_key_deep_seek=         # DeepSeek
# api_key_aliyun_domestic=   # Aliyun DashScope, mainland endpoint
# api_key_aliyun_external=   # Aliyun DashScope, international endpoint

# Other providers the library supports but this study does not use:
# api_key_volcano=
# api_key_zhipuai=
# api_key_baidu_api=
# api_key_baidu_key=
# api_key_baidu_secret=
# api_key_wb=
# api_key_hf=
# api_key_aws_key=
# api_key_aws_secret=
